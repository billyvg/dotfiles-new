# Shared Brewfile — CLI tools wanted on every machine, macOS and Linux alike.
#
# On Linux this is deliberately SMALL: linuxbrew frequently misses bottles and
# falls back to building from source, which can take 10-30min on a cold
# workspace. Anything apt ships at an acceptable version lives in
# apt-packages.txt instead. See install.sh.

brew "neovim"                # apt's nvim is far too old for vim.pack (>= 0.12)
brew "git-delta"             # git pager; no apt package
brew "difftastic"            # structural differ; gitconfig sets diff.external=difft
brew "fzf"
brew "ripgrep"
brew "fd"
brew "bat"
brew "gh"
brew "scmpuff"               # no apt package
brew "herdr"
brew "agent-browser"
