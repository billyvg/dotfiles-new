# macOS-specific zsh config. Symlinked to ~/.zshrc.os by install.sh.
# Sourced from .zshrc *before* compinit, so it may add to fpath.

# BSD ls uses -G; GNU coreutils (via brew) uses --color.
if (( ${+commands[gls]} )); then
  alias ls="gls --color=auto"
else
  alias ls="ls -G"
fi

alias o="open"

# gettext, if brewed
if (( ${+commands[brew]} )); then
  [[ -d "$(brew --prefix)/opt/gettext/bin" ]] && \
    export PATH="$(brew --prefix)/opt/gettext/bin:$PATH"
fi

# --- Sentry -----------------------------------------------------------------
# Deliberately macOS-only: the Coder dev boxes don't run devenv.
[[ -d "$HOME/.local/share/sentry-devenv/bin" ]] && \
  export PATH="$HOME/.local/share/sentry-devenv/bin:$PATH"
[[ -d "$HOME/code/sentry" ]] && export PATH="$HOME/code/sentry:$PATH"

# sentry completions -- must land on fpath before compinit runs
[[ -d "$HOME/.local/share/zsh/site-functions" ]] && \
  fpath=("$HOME/.local/share/zsh/site-functions" $fpath)

export SLACK_DEVELOPER_MENU=true

# prettierd can't write to /var/run on macOS
export XDG_RUNTIME_DIR="$HOME/.local/run"
[[ -d "$XDG_RUNTIME_DIR" ]] || mkdir -p "$XDG_RUNTIME_DIR"

# --- Google Cloud SDK -------------------------------------------------------
for _gcloud in "$HOME/code/google-cloud-sdk" "$HOME/google-cloud-sdk" \
               "$(brew --prefix 2>/dev/null)/share/google-cloud-sdk"; do
  if [[ -f "$_gcloud/path.zsh.inc" ]]; then
    source "$_gcloud/path.zsh.inc"
    [[ -f "$_gcloud/completion.zsh.inc" ]] && source "$_gcloud/completion.zsh.inc"
    break
  fi
done
unset _gcloud

wine-gptk() { WINEESYNC=1 WINEPREFIX=~/.wine /usr/local/bin/wine64 "$@"; }
